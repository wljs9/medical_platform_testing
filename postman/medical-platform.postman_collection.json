{
  "info": {
    "name": "医疗管理平台-接口测试",
    "description": "medical_platform 全量接口测试集合。5个资源文件夹(01-05)为正向用例,文件夹06为参数校验与异常场景(重点产出缺陷)。使用前确认后端已启动,base_url 变量指向服务地址。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "01 科室 Department",
      "item": [
        {
          "name": "01-01 GET 查询全部科室",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });",
            "pm.test(\"响应时间 < 2000ms\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
            "pm.test(\"返回数组且包含10个科室\", function () { var j = pm.response.json(); pm.expect(j).to.be.an('array'); pm.expect(j.length).to.be.at.least(1); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/departments", "host": ["{{base_url}}"], "path": ["api", "departments"] }
          }
        },
        {
          "name": "01-02 GET 按ID查询科室(id=1)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });",
            "pm.test(\"返回对象含 departmentId\", function () { var j = pm.response.json(); pm.expect(j).to.have.property('departmentId'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/departments/1", "host": ["{{base_url}}"], "path": ["api", "departments", "1"] }
          }
        },
        {
          "name": "01-03 GET 按名称查询科室(内科)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/departments/name/内科", "host": ["{{base_url}}"], "path": ["api", "departments", "name", "内科"] }
          }
        },
        {
          "name": "01-04 GET 科室总数",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });",
            "pm.test(\"返回数字\", function () { pm.expect(typeof pm.response.json()).to.eql('number'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/departments/count", "host": ["{{base_url}}"], "path": ["api", "departments", "count"] }
          }
        },
        {
          "name": "01-05 POST 创建科室",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });",
            "pm.test(\"返回创建成功提示\", function () { pm.expect(pm.response.text()).to.include('成功'); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"departmentName\": \"测试科室_自动化\" }", "options": { "raw": "json" } },
            "url": { "raw": "{{base_url}}/api/departments", "host": ["{{base_url}}"], "path": ["api", "departments"] }
          }
        },
        {
          "name": "01-06 POST 批量创建科室",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "[ { \"departmentName\": \"批量科室A\" }, { \"departmentName\": \"批量科室B\" } ]", "options": { "raw": "json" } },
            "url": { "raw": "{{base_url}}/api/departments/batch", "host": ["{{base_url}}"], "path": ["api", "departments", "batch"] }
          }
        },
        {
          "name": "01-07 PUT 更新科室(id=1)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"departmentName\": \"内科(更新后)\" }", "options": { "raw": "json" } },
            "url": { "raw": "{{base_url}}/api/departments/1", "host": ["{{base_url}}"], "path": ["api", "departments", "1"] }
          }
        },
        {
          "name": "01-08 DELETE 删除科室(删除刚创建的测试科室)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/departments/999999", "host": ["{{base_url}}"], "path": ["api", "departments", "999999"] },
            "description": "先在 MySQL 里查出'测试科室_自动化'的真实ID替换999999,删除后再 GET 全部科室验证已消失。"
          }
        }
      ]
    },
